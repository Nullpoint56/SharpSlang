<Project>

  <!--
    Single source of truth for the pinned Slang release, the pinned SharpNRI release, and the pinned
    DirectXShaderCompiler release.

    Slang's public ABI is explicitly not stable (AGENTS.md#pin-and-payload), so this is an exact
    pin, not a floor. Everything downstream reads it from here:

      tools/generate-native.ps1   default -SlangVersion, and the header cache path
      tools/fetch-native.ps1      which release archive to download per RID
      dotnet/SharpSlang.csproj    package metadata
      tests/                      which header the drift tests parse

    Bumping Slang is therefore: change this line, re-run both tools, run the tests, review the diff.
  -->

  <!--
    Lint, for every project: the SDK's own analyzers and no analyzer package. The CA rules at
    latest-recommended and the IDE code-style rules in the build, configured in .editorconfig, where
    every exemption sits with its reason. pwsh tools/check.ps1 and the CI lint job build with
    warnings as errors and check the formatting with dotnet format whitespace, as tools/check.ps1
    spells out.

    XML docs on: they ship in the packages for IntelliSense, and with them on the build checks every
    doc comment, so a malformed one (a cref to nothing, a param that does not exist) fails. A
    missing one does not (CS1591).
  -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Package metadata every package shares. The package page is docs/nuget/README.md with its
    repository links pointed at the release tag (Directory.Build.targets).

    Debugging into the binding from an application: the package records the repository and the
    commit it was built from (<repository commit>), each portable PDB ships beside its DLL, and
    the SDK's own Source Link (no Microsoft.SourceLink package: .NET 8 and later carry it) maps
    the PDB's documents to that commit on GitHub; the generated files of obj/ (SlangHeaders.g.cs,
    the JSON source generator's) are embedded in the PDB instead. tools/ci/check-packages.ps1 reads
    each packed PDB's Source Link map. The release pack adds ContinuousIntegrationBuild
    (deterministic, repository-relative paths); local and test builds keep their real paths.
  -->
  <PropertyGroup>
    <Authors>szombathy-tamas</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Nullpoint56/SharpSlang</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Nullpoint56/SharpSlang</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup>
    <SlangVersion>v2026.21</SlangVersion>

    <!--
      Package versions (AGENTS.md#decisions): every package's major is the Slang version as a
      fixed-width YYYYRRP, so v2026.21 is 2026210 and v2026.18.3 is 2026183 (AGENTS.md#decisions);
      Directory.Build.targets fails a build whose package major is not SlangVersion's encoding
      (SHARPSLANG004). Within one Slang version a breaking binding change moves the second number,
      a fix the third; beta while the API may change.

        SharpSlangVersion          the release: tag v<it>; SharpSlang, SharpSlang.Dxc,
                                   SharpSlang.Pipeline.Bake, SharpSlang.Pipeline.NRI
        SharpSlangDescsVersion     SharpSlang.Descs, moved only when the descs change
                                   (tools/ci/descs-version.ps1): a binding-only release reuses the
                                   published Descs, so a library built on them needs no release
        SharpSlangPipelineVersion  SharpSlang.Pipeline, the reader, moved only when the reader
                                   changes, the same way (tools/ci/packages.psd1)

      SharpSlang depends on the Descs and the reader it was built with exactly ([v]); a direct
      reference to another Descs fails the consumer's build (SHARPSLANG005,
      dotnet/buildTransitive/SharpSlang.targets), and global-session creation refuses a loaded
      Descs of another version (AGENTS.md#pin-and-payload).
    -->
    <SharpSlangVersion>2026210.0.0-beta.1</SharpSlangVersion>
    <SharpSlangDescsVersion>2026210.0.0-beta.1</SharpSlangDescsVersion>
    <SharpSlangPipelineVersion>2026210.0.0-beta.1</SharpSlangPipelineVersion>

    <!--
      The pinned SharpNRI release, from nuget.org: SharpNRI (the binding and NRI's native library)
      and SharpNRI.Testing (its validated headless device) at SharpNriPackageVersion, and
      SharpNRI.Descs (NRI's descriptor structs and enums, no native code) at
      SharpNriDescsPackageVersion. The two differ because SharpNRI.Descs is versioned by NRI and
      released only when the descs change (equal while they are). Each package's major is the NRI version: 192.x is NRI
      v192. Read by:

        pipeline-nri/SharpSlang.Pipeline.NRI.csproj     SharpNRI.Descs, the one package the projection references
        tests/SharpSlang.Tests        SharpNRI and SharpNRI.Testing

      Exact, like the Slang pin, and for a smaller version of the same reason: the descs are a
      transcription of one NRI header revision, so a newer one can move a field. SharpNRI itself
      depends on exactly one SharpNRI.Descs, [192.0.0-beta.1] for 192.0.0-beta.1. A Descs pin here
      that disagrees with it does not fail the restore: measured with 1.0.0-beta.2, the tests'
      restore warns NU1608 and resolves SharpNRI's Descs for the tests while SharpSlang.Pipeline.NRI builds
      against the pin. CI's build runs with -warnaserror, which makes that warning the error. And
      NriProjectionTests pins the NRI version every reading reports to the one the projection's
      rules were measured against.

      Named *PackageVersion, and not SharpNRIVersion: MSBuild property names ignore case, and the
      SharpNRI packages' own build files define SharpNRI* properties.

      Bumping it is: change these lines, restore, run the tests, and re-read the rules
      NriProjectionTests names if the NRI major moved.
    -->
    <SharpNriPackageVersion>192.0.0-beta.1</SharpNriPackageVersion>
    <SharpNriDescsPackageVersion>192.0.0-beta.1</SharpNriDescsPackageVersion>

    <!--
      The pinned Microsoft.Direct3D.DXC package, for SharpSlang.Dxc only. Slang compiles to
      DXIL by loading dxc as a downstream compiler, by name, from the library search path — the same
      way it loads slang-glslang — and Slang's own release ships neither dxcompiler.dll nor dxil.dll.
      So a D3D12 consumer either brings dxc itself or takes the opt-in package, which copies it into
      the application's output, where SharpSlang loads it from before Slang asks for it by name.

      That package carries no binary. It depends on Microsoft's own NuGet package of dxc at exactly
      this version and copies the two DLLs out of it; the first version repackaged them from the
      DirectXShaderCompiler GitHub release, and Microsoft's licence terms in that release forbid a
      stand-alone offering of the files, which a payload-only package is. Read by:

        dxc/SharpSlang.Dxc.csproj                    the PackageReference, as an exact range
        dxc/buildTransitive/SharpSlang.Dxc.targets   restated there as the version the restore must
                                                     resolve (SHARPSLANG011) and copy from, since
                                                     NuGet hands a consumer no version property for
                                                     a transitive package; DocumentedFactsTests pins
                                                     the two to each other
        tests/SharpSlang.Tests                       the same reference and import, so the DXIL
                                                     tests find dxc beside the compiler

      1.9.2609.5 was the newest non-prerelease version on 2026-10-14 (1.10.2605.37-preview is newer
      by date and marked preview); it is the same build as the v1.9.2609 GitHub release, and the
      DLLs report file version 1.9.2609.5. Measured with it: Slang 2026.21 reports dxc available,
      compiles the corpus to DXIL, and a compute shader dispatched on D3D12 through the NRI
      projection reads back correctly.

      Bumping it is: change this line and the one in the targets file, restore, run the DXIL tests.
    -->
    <DxcPackageVersion>1.9.2609.5</DxcPackageVersion>

    <!--
      The newest glibc and libstdc++ symbol versions the Linux payload may need: the oldest Linux
      it loads on. Slang's own v2026.21 release, built on Ubuntu 22.04, needs exactly these on
      linux-x64 and linux-arm64 (read from each library's version-needs section). A build on Ubuntu
      24.04 needs GLIBC_2.38 and GLIBCXX_3.4.32 (__isoc23_strtol, std::ios_base_library_init) and
      would not load on 22.04 or Debian 12, so Linux payloads are built on ubuntu-22.04. Read by
      tools/build-native.ps1, which refuses a build above them unless -AllowNewerGlibc, and by
      NativePayloadTests, which fails on a staged library above them (AGENTS.md#pin-and-payload).
      Raising them is a decision: it drops the distributions below.
    -->
    <LinuxGlibcFloor>2.34</LinuxGlibcFloor>
    <LinuxGlibcxxFloor>3.4.29</LinuxGlibcxxFloor>
  </PropertyGroup>

</Project>
