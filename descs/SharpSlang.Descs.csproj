<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpSlang.Descs: Slang's vocabulary as data, with no native dependency.

    Every enum, descriptor struct, COM interface layout, IID and opaque handle type the generator
    emits lives here: everything in dotnet/Native except SlangApi.cs, the one file that names the
    native library (../NativeSplit.props). A reflection snapshot names SlangStage and
    SlangParameterCategory; a library that builds Slang descs or reads baked packages must not carry
    a 36 MB compiler to name them. This is the assembly it references. SharpSlang references it
    exactly and adds the imports and the hand-written layers on top; SharpSlang.Pipeline, the
    reader, references it exactly and nothing native. One definition of each type.

    No hand-written source: the managed desc forms the template allows for here (a second form of
    a desc that holds pointer + count) do not exist in SharpSlang yet; the descriptor defaults
    (dotnet/Defaults.cs) read SlangApi's constants and stay in the binding.
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\NativeSplit.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SharpSlang</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <PackageId>SharpSlang.Descs</PackageId>
    <Version>$(SharpSlangDescsVersion)</Version>
    <Authors>szombathy-tamas</Authors>
    <Description>Slang $(SlangVersion)'s enums, descriptor structs, COM interface layouts and IIDs as plain .NET types, generated from the pinned slang.h. No native dependency: reference this to name Slang's types without the compiler.</Description>
    <PackageTags>slang;shader;spirv;reflection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="@(SharpSlangGeneratedDesc)" Link="Native\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    SlangHeaders.Version: the Slang release the descs were generated from, as a constant, compiled
    into every caller (written from Directory.Build.props' SlangVersion at build time; the
    AssemblyMetadata below says the same at run time, and global-session creation compares it with
    the binding's).
  -->
  <Target Name="SharpSlangWriteSlangHeaders" BeforeTargets="CoreCompile;BeforeCompile">
    <PropertyGroup>
      <!-- inside the target: IntermediateOutputPath is not set yet where this file's properties are evaluated -->
      <_SharpSlangHeadersFile>$(IntermediateOutputPath)SlangHeaders.g.cs</_SharpSlangHeadersFile>
    </PropertyGroup>
    <ItemGroup>
      <_SharpSlangHeadersLine Include="// Generated by SharpSlang.Descs.csproj from Directory.Build.props (SlangVersion). Do not edit." />
      <_SharpSlangHeadersLine Include="namespace SharpSlang%3B" />
      <_SharpSlangHeadersLine Include="/// &lt;summary&gt;The Slang headers SharpSlang.Descs was generated from.&lt;/summary&gt;" />
      <_SharpSlangHeadersLine Include="public static class SlangHeaders" />
      <_SharpSlangHeadersLine Include="{" />
      <_SharpSlangHeadersLine Include="    /// &lt;summary&gt;The Slang release of the headers, as its build tag reports it (&lt;c&gt;$(SlangVersion.TrimStart('v'))&lt;/c&gt;). Its YYYYRRP encoding is the major of this package's version. Compiled into the caller.&lt;/summary&gt;" />
      <_SharpSlangHeadersLine Include="    public const string Version = &quot;$(SlangVersion.TrimStart('v'))&quot;%3B" />
      <_SharpSlangHeadersLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_SharpSlangHeadersFile)" Lines="@(_SharpSlangHeadersLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_SharpSlangHeadersFile)" />
      <FileWrites Include="$(_SharpSlangHeadersFile)" />
    </ItemGroup>
  </Target>

  <!-- The major's encoding is computed in Directory.Build.targets, after this file's properties -->
  <Target Name="SharpSlangDescsDescription" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <PackageDescription>$(Description) The major of the version is the Slang version as YYYYRRP ($(SharpSlangVersionMajor) is Slang $(SlangVersion)); pin one major.</PackageDescription>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="SlangVersion" Value="$(SlangVersion)" />
    <!-- SlangApi.cs, compiled into SharpSlang, names the generated layer's internal NativeTypeName attribute -->
    <InternalsVisibleTo Include="SharpSlang" />
    <InternalsVisibleTo Include="SharpSlang.Tests" />
  </ItemGroup>

</Project>
