<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PrismSlang — managed bindings over the Slang shader compiler.

    Pure managed: there is no native code in this repository. The native payload is Slang's own
    prebuilt per-RID release, fetched by tools/fetch-native.ps1 and pinned to $(SlangVersion).
    See docs/design.md for the surface study and the layering rationale.

    Layout:
      Native/     L0  generated by tools/generate-native.ps1 — DO NOT EDIT
      Defaults.cs     hand-written; restores C++ default member initializers ClangSharp drops
      (L1-L4 land here as they are written: Interop/, Compilation/, Reflection/, Hosting/)
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\NativeReaderEnums.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PrismSlang</RootNamespace>

    <!-- $(SlangVersion) is pinned in ../Directory.Build.props — the single source of truth. -->

    <!-- NuGet identity -->
    <PackageId>PrismSlang</PackageId>
    <Version>0.1.0-alpha</Version>
    <Authors>szombathy-tamas</Authors>
    <Description>C# bindings over the Slang shader compiler: compilation and full reflection. Pure managed P/Invoke, no C++/CLI. Windows x64, Linux x64, Linux arm64, macOS arm64. Alpha: built for the PrismEngine renderer and not yet load-tested by a shipping game.</Description>
    <PackageTags>slang;shader;spirv;vulkan;shader-compiler;reflection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- This package and the opt-in PrismSlang.Native.Dxc are the only ones that redistribute
       anything, so they are the ones that carry the notice. Slang's own licence texts ride along
       under runtimes/<rid>/, staged there by tools/fetch-native.ps1; this file is what explains
       them. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The generated layer is machine-authored; its style is not ours to police. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0169;CS0649;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests reach into Defaults and the L0 layer deliberately; the sample does not, and that is
         the point: once L2 existed the sample stopped needing internal access at all. If a future
         sample needs it back, that is a signal the public API has a hole. -->
    <InternalsVisibleTo Include="PrismSlang.Tests" />

    <!--
      The crash prober, for the same reason. Its whole job is to demonstrate what a managed guard
      prevents, which means calling the layer the guard sits on top of — and that layer is internal
      precisely so nobody else does.
    -->
    <InternalsVisibleTo Include="PrismSlang.Prober" />
  </ItemGroup>

  <!--
    The pin, carried into the assembly so SlangGlobalSession.Create can compare it against what the
    loaded library reports. Slang's ABI is explicitly unstable (docs/design.md §3.5), so a payload
    from a different release is undefined behaviour dressed as a working build: the vtables the
    generated layer indexes into are the pinned header's, not the payload's.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="SlangVersion" Value="$(SlangVersion)" />
  </ItemGroup>

  <!--
    The reader half. PrismSlang.Runtime holds ShaderPackage, the reflection snapshot, the SPIR-V
    reader and the generated enums those name — everything that works without the native payload.
    Referencing it here rather than duplicating means one definition of ProgramLayout, so a type
    crossing between a cooker and a game loader is the same type.

    The Compile Remove is the other half of that: the generator still writes every enum to Native/,
    and these ones are compiled into PrismSlang.Runtime instead. Without the removal both assemblies
    would define SlangStage and nothing would agree about which one a ShaderParameter holds.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\runtime\PrismSlang.Runtime.csproj" />
    <Compile Remove="@(PrismSlangReaderEnum)" />
  </ItemGroup>

  <!--
    Native payload, staged by tools/fetch-native.ps1 into ../runtimes/<rid>/native.

    Shipped two ways, as PrismUSD does:
      * NuGet           — packed under runtimes/<rid>/native, the standard RID-native convention,
                          so the host resolves the right one per platform.
      * ProjectReference — the *host* RID's files only, copied flat next to the consumer's exe.
                          Copying every RID flat would collide on filename.
  -->
  <PropertyGroup>
    <PrismSlangRid Condition="'$(PrismSlangRid)' == ''">$(RuntimeIdentifier)</PrismSlangRid>
    <PrismSlangRid Condition="'$(PrismSlangRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</PrismSlangRid>
  </PropertyGroup>

  <!--
    The two globs below must stay DISJOINT. They originally overlapped on the host RID — its files
    matched both, and the Content item's Pack="false" won, so the published package contained every
    RID *except* the one it was built on. A win-x64 build shipped a package with no win-x64 payload:
    it packs cleanly, restores cleanly, and fails at run time with DllNotFoundException.
    Caught by inspecting the .nupkg, which is why publish.yml uploads it as an artifact.
  -->
  <ItemGroup>
    <!-- Host RID: packed under its RID folder AND copied flat for ProjectReference consumers. -->
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(PrismSlangRid)\native\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Pack="true"
             PackagePath="runtimes\$(PrismSlangRid)\native\%(RecursiveDir)%(Filename)%(Extension)"
             Visible="false" />

    <!-- Every other RID: packed only. Copying them flat would collide on filename. -->
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\**\*"
          Exclude="$(MSBuildThisFileDirectory)..\runtimes\$(PrismSlangRid)\native\**\*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <Target Name="PrismSlangWarnIfNoNative" BeforeTargets="Build"
          Condition="!Exists('$(MSBuildThisFileDirectory)..\runtimes\$(PrismSlangRid)\native')">
    <Warning Text="No native payload for '$(PrismSlangRid)'. Run: pwsh tools/fetch-native.ps1 -Rid $(PrismSlangRid)" />
  </Target>

</Project>
