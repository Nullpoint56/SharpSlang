<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpSlang — managed bindings over the Slang shader compiler.

    Pure managed: there is no native code in this repository. The native payload is Slang's own
    prebuilt per-RID release, fetched by tools/fetch-native.ps1 and pinned to $(SlangVersion).
    See AGENTS.md for the layers, the pin and the decisions behind them.

    Layout:
      Native/     L0  generated by tools/generate-native.ps1 — DO NOT EDIT. Only SlangApi.cs
                      compiles here; the rest compiles into SharpSlang.Descs (../NativeSplit.props)
      Defaults.cs     hand-written; restores C++ default member initializers ClangSharp drops
      Interop/    L1  lifetime, blobs, results and diagnostics, callback thunks, the version guard
      Core/       L2  one class per Slang object (Core/Reflection/: the reflection objects)
      Extensions/ L3  Slang's optional interfaces, acquired on first use (TryX / X)
  -->

  <Import Project="$(MSBuildThisFileDirectory)..\NativeSplit.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SharpSlang</RootNamespace>

    <!-- $(SlangVersion) is pinned in ../Directory.Build.props — the single source of truth. -->

    <!-- NuGet identity -->
    <PackageId>SharpSlang</PackageId>
    <Version>$(SharpSlangVersion)</Version>
    <Authors>szombathy-tamas</Authors>
    <Description>C# bindings over the Slang shader compiler: compilation and full reflection. Pure managed P/Invoke, no C++/CLI. Windows x64, Linux x64, Linux arm64, macOS arm64. Alpha: not yet load-tested by a shipping game.</Description>
    <PackageTags>slang;shader;spirv;vulkan;shader-compiler;reflection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <!-- This package is the only one that redistributes anything, so it carries the notice; the
       opt-in SharpSlang.Dxc carries it too, to say why it redistributes nothing. Slang's
       own licence texts ride along under runtimes/<rid>/, staged there by tools/fetch-native.ps1;
       this file is what explains them. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests reach into Defaults and the L0 layer deliberately; the sample does not, and that is
         the point: once L2 existed the sample stopped needing internal access at all. If a future
         sample needs it back, that is a signal the public API has a hole. -->
    <InternalsVisibleTo Include="SharpSlang.Tests" />

    <!--
      The crash prober, for the same reason. Its whole job is to demonstrate what a managed guard
      prevents, which means calling the layer the guard sits on top of — and that layer is internal
      precisely so nobody else does.
    -->
    <InternalsVisibleTo Include="SharpSlang.Prober" />
  </ItemGroup>

  <!--
    The pins, carried into the assembly so SlangGlobalSession.Create can compare them with what is
    loaded (Interop/SlangVersionCheck.cs): SlangVersion with the native library's build tag and
    with the loaded SharpSlang.Descs' own SlangVersion, and SharpSlangDescsVersion, the Descs
    package this one depends on exactly, with the loaded Descs' package version. Slang's ABI is
    explicitly unstable (AGENTS.md#pin-and-payload), so a payload from a different release is
    undefined behaviour dressed as a working build: the vtables the generated layer indexes into are
    the pinned header's, not the payload's.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="SlangVersion" Value="$(SlangVersion)" />
    <AssemblyMetadata Include="SharpSlangDescsVersion" Value="$(SharpSlangDescsVersion)" />
  </ItemGroup>

  <!--
    L0 is split by file (../NativeSplit.props): SlangApi.cs, the one file with DllImports, compiles
    here; every other generated file compiles into SharpSlang.Descs, referenced exactly (the packed
    dependency is [$(SharpSlangDescsVersion)], Directory.Build.targets).

    Nothing else. The pipeline packages (SharpSlang.Pipeline, .Pipeline.Bake, .Pipeline.NRI) are
    built on this assembly's public API and this assembly names none of them (AGENTS.md#layers);
    AssemblySplitTests reads its references from metadata.
  -->
  <ItemGroup>
    <Compile Remove="Native\**\*.cs" />
    <Compile Include="@(SharpSlangGeneratedImport)" Link="Native\%(Filename)%(Extension)" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\descs\SharpSlang.Descs.csproj" />
  </ItemGroup>

  <!--
    buildTransitive/SharpSlang.props, written at pack time: the SharpSlang.Descs version this
    package depends on, which buildTransitive/SharpSlang.targets holds a consumer's restore to
    (SHARPSLANG005). A direct reference to another Descs wins NuGet's restore with only NU1608, and
    global-session creation would then refuse it.
  -->
  <PropertyGroup>
    <_SharpSlangProps>$(BaseIntermediateOutputPath)SharpSlang.props</_SharpSlangProps>
  </PropertyGroup>
  <Target Name="SharpSlangWriteProps" BeforeTargets="Build;_GetPackageFiles">
    <ItemGroup>
      <_SharpSlangPropsLine Include="&lt;Project&gt;" />
      <_SharpSlangPropsLine Include="  &lt;!-- Written by SharpSlang.csproj at pack time --&gt;" />
      <_SharpSlangPropsLine Include="  &lt;PropertyGroup&gt;" />
      <_SharpSlangPropsLine Include="    &lt;SharpSlangPackedVersion&gt;$(Version)&lt;/SharpSlangPackedVersion&gt;" />
      <_SharpSlangPropsLine Include="    &lt;SharpSlangDescsDependency&gt;$(SharpSlangDescsVersion)&lt;/SharpSlangDescsDependency&gt;" />
      <_SharpSlangPropsLine Include="  &lt;/PropertyGroup&gt;" />
      <_SharpSlangPropsLine Include="&lt;/Project&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(_SharpSlangProps)" Lines="@(_SharpSlangPropsLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <ItemGroup>
    <None Include="$(_SharpSlangProps)" Pack="true" PackagePath="buildTransitive\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)buildTransitive\SharpSlang.targets" Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>

  <!--
    Native payload, staged by tools/fetch-native.ps1 into ../runtimes/<rid>/native.

    Shipped two ways, as PrismUSD does:
      * NuGet           — packed under runtimes/<rid>/native, the standard RID-native convention,
                          so the host resolves the right one per platform.
      * ProjectReference — the *host* RID's files only, copied flat next to the consumer's exe.
                          Copying every RID flat would collide on filename.
  -->
  <PropertyGroup>
    <SharpSlangRid Condition="'$(SharpSlangRid)' == ''">$(RuntimeIdentifier)</SharpSlangRid>
    <SharpSlangRid Condition="'$(SharpSlangRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</SharpSlangRid>
  </PropertyGroup>

  <!--
    The two globs below must stay DISJOINT. They originally overlapped on the host RID — its files
    matched both, and the Content item's Pack="false" won, so the published package contained every
    RID *except* the one it was built on. A win-x64 build shipped a package with no win-x64 payload:
    it packs cleanly, restores cleanly, and fails at run time with DllNotFoundException.
    Caught by inspecting the .nupkg, which is why publish.yml uploads it as an artifact.
  -->
  <ItemGroup>
    <!-- Host RID: packed under its RID folder AND copied flat for ProjectReference consumers. -->
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\$(SharpSlangRid)\native\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             Pack="true"
             PackagePath="runtimes\$(SharpSlangRid)\native\%(RecursiveDir)%(Filename)%(Extension)"
             Visible="false" />

    <!-- Every other RID: packed only. Copying them flat would collide on filename. -->
    <None Include="$(MSBuildThisFileDirectory)..\runtimes\**\*"
          Exclude="$(MSBuildThisFileDirectory)..\runtimes\$(SharpSlangRid)\native\**\*"
          Pack="true"
          PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)"
          Visible="false" />
  </ItemGroup>

  <!--
    The native library is built, never committed. Without it a build from source succeeds and the
    first SlangGlobalSession.Create fails with a DllNotFoundException in the consumer, far from the
    cause; so the build stops here instead, naming the directory and the command, as SharpNRI's
    SHARPNRI001 does. Packages are unaffected: they carry the payload.
    -p:SharpSlangRequireNative=false builds anyway: a build that only lints (tools/check.ps1, the
    CI lint job), whose analyzers need no payload, or managed-only work on a RID without one.
    tools/fetch-native.ps1 stages the same layout from Slang's release until CI builds from source.
  -->
  <PropertyGroup>
    <SharpSlangNativeDir>$(MSBuildThisFileDirectory)..\runtimes\$(SharpSlangRid)\native\</SharpSlangNativeDir>
  </PropertyGroup>

  <Target Name="SharpSlangRequireNative" BeforeTargets="Build"
          Condition="'$(SharpSlangRequireNative)' != 'false'
                     and !Exists('$(SharpSlangNativeDir)slang-compiler.dll')
                     and !Exists('$(SharpSlangNativeDir)libslang-compiler.so')
                     and !Exists('$(SharpSlangNativeDir)libslang-compiler.dylib')">
    <Error Code="SHARPSLANG001"
           Text="The Slang native library for '$(SharpSlangRid)' is not built: $([System.IO.Path]::GetFullPath('$(SharpSlangNativeDir)')) has no slang-compiler.dll, libslang-compiler.so or libslang-compiler.dylib. In the repository run: git submodule update --init --recursive slang, then pwsh tools/build-native.ps1 -Rid $(SharpSlangRid). (-p:SharpSlangRequireNative=false skips this check.)" />
  </Target>

</Project>
