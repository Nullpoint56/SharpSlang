<!--
  Imported into every project that references the SharpSlang.Dxc package, directly or through
  another package (buildTransitive/net11.0/), and imported by path into the repository's test and
  prober projects. It copies dxc into the root of the consumer's output. That is beside
  slang-compiler.dll for a RID-specific build, and one runtimes\win-x64\native\ away from it for a
  portable one; SlangGlobalSession loads dxc from either before Slang looks for it by name
  (CompanionLibraries in SharpSlang says why that has to be done for it).

  The DLLs come from Microsoft.Direct3D.DXC, Microsoft's own NuGet package, which this package
  depends on at an exact version. That package lays them out for C++ consumers — a build/native/
  tree with props and targets that only a vcxproj imports — so a .NET project that references it
  gets nothing copied, and this file does the copy instead. Copied from the package cache rather
  than carried here: SharpSlang redistributes no Microsoft binary, and a consumer takes Microsoft's
  terms by restoring Microsoft's package (THIRD-PARTY-NOTICES.md).

  The version below is the one dependency version this package declares, restated because a
  transitive package's version is not handed to a consumer as a property. DocumentedFactsTests pins
  it to the DxcPackageVersion in Directory.Build.props. A restore that resolved another version
  fails the build (SHARPSLANG011): the version is read from project.assets.json, so the check holds
  whatever the package cache already contains. It once only checked that the pinned version's
  folder existed, and a wrong version built whenever the pin had been restored on that machine
  before (tools/consume, wrong dxc with the pin in the cache).

  The copy is win-x64 only, for the same reason the package is: the binaries are x64 Windows builds,
  and on any other host they would sit beside a slang-compiler that cannot load them. The version
  check runs on every host: the restore is wrong whichever machine builds it.
-->
<Project>

  <PropertyGroup>
    <SharpSlangDxcPackageVersion Condition="'$(SharpSlangDxcPackageVersion)' == ''">1.9.2609.5</SharpSlangDxcPackageVersion>

    <!-- The host RID, resolved as dotnet/SharpSlang.csproj resolves it for the Slang payload. -->
    <SharpSlangDxcHostRid Condition="'$(SharpSlangDxcHostRid)' == ''">$(RuntimeIdentifier)</SharpSlangDxcHostRid>
    <SharpSlangDxcHostRid Condition="'$(SharpSlangDxcHostRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</SharpSlangDxcHostRid>

    <!-- The Microsoft.Direct3D.DXC version NuGet resolved, as project.assets.json records it -->
    <_SharpSlangDxcAssets Condition="'$(ProjectAssetsFile)' != '' and Exists('$(ProjectAssetsFile)')">$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_SharpSlangDxcAssets>
    <_SharpSlangDxcResolved>$([System.Text.RegularExpressions.Regex]::Match($(_SharpSlangDxcAssets), '"(?i:microsoft\.direct3d\.dxc)/([^"]+)"').Groups[1].Value)</_SharpSlangDxcResolved>

    <!--
      EnsureTrailingSlash, because the package root does not always end in one. NuGet writes it
      with a separator for the default cache and without one for a globalPackagesFolder set in
      nuget.config. Concatenated bare, the path became obj\packagesmicrosoft.direct3d.dxc\... and
      the copy failed with MSB3030: found by publish.yml's portable consumer.
    -->
    <SharpSlangDxcBin>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))microsoft.direct3d.dxc\$(SharpSlangDxcPackageVersion)\build\native\bin\x64\</SharpSlangDxcBin>
  </PropertyGroup>

  <ItemGroup Condition="'$(SharpSlangDxcHostRid)' == 'win-x64' and '$(_SharpSlangDxcResolved)' == '$(SharpSlangDxcPackageVersion)'">
    <None Include="$(SharpSlangDxcBin)dxcompiler.dll;$(SharpSlangDxcBin)dxil.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

  <!--
    Before BeforeBuild, the first target Build runs, so it comes before the references are resolved
    and before anything is compiled or copied. Hooked before Build it ran after CoreBuild, whose
    copy failed first with two MSB3030s (measured with a version the cache did not hold).
  -->
  <Target Name="SharpSlangDxcCheck" BeforeTargets="BeforeBuild">
    <Error Code="SHARPSLANG010" Condition="'$(_SharpSlangDxcResolved)' == ''"
           Text="SharpSlang.Dxc: Microsoft.Direct3D.DXC is not in $(ProjectAssetsFile). Restore the project; a project that imports SharpSlang.Dxc.targets by path references Microsoft.Direct3D.DXC $(SharpSlangDxcPackageVersion) itself." />
    <Error Code="SHARPSLANG011" Condition="'$(_SharpSlangDxcResolved)' != '' and '$(_SharpSlangDxcResolved)' != '$(SharpSlangDxcPackageVersion)'"
           Text="SharpSlang.Dxc copies dxc from Microsoft.Direct3D.DXC $(SharpSlangDxcPackageVersion) exactly, and this project restores Microsoft.Direct3D.DXC $(_SharpSlangDxcResolved). Reference Microsoft.Direct3D.DXC $(SharpSlangDxcPackageVersion), or drop the explicit reference." />
    <Error Code="SHARPSLANG012" Condition="'$(SharpSlangDxcHostRid)' == 'win-x64' and '$(_SharpSlangDxcResolved)' == '$(SharpSlangDxcPackageVersion)' and (!Exists('$(SharpSlangDxcBin)dxcompiler.dll') or !Exists('$(SharpSlangDxcBin)dxil.dll'))"
           Text="SharpSlang.Dxc: dxcompiler.dll and dxil.dll are not both in $(SharpSlangDxcBin), the restored Microsoft.Direct3D.DXC $(_SharpSlangDxcResolved)." />
  </Target>

</Project>
