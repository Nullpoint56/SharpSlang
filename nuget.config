<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Where packages come from, and only these two places.

    prismnri-local is a folder feed in the repository, nupkg-feed/, filled by
    `pwsh tools/fetch-nri.ps1` from the GitHub release of the pinned PrismNRI version
    (PrismNriVersion in Directory.Build.props). PrismNRI is a private repository: its packages are
    not on nuget.org, and consuming them from GitHub Packages would make every restore — on every
    developer machine and every CI leg — need a token with package read access to another
    repository. A folder feed moves that need to one script, run once per pin, whose output is
    cacheable. The packages themselves are gitignored; the folder is not, so this source always
    exists.

    <clear/> because NuGet merges package sources from every nuget.config up the directory tree
    and from the user-wide one. A developer who has a GitHub Packages source configured
    machine-wide (anyone who has ever consumed a private package from GitHub) would otherwise have
    it consulted on every restore here, and a source that wants credentials it does not have
    prompts or fails the restore — for packages it was never going to supply. Clearing makes the
    restore the same on every machine: this repository's two sources and nothing else.
  -->
  <packageSources>
    <clear />
    <add key="prismnri-local" value="nupkg-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
