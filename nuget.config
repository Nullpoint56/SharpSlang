<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Where packages come from: nuget.org, and only nuget.org. Every package this repository
    restores is there, SharpNRI's included.

    <clear/> because NuGet merges package sources from every nuget.config up the directory tree
    and from the user-wide one. A developer who has a GitHub Packages source configured
    machine-wide (anyone who has ever consumed a private package from GitHub) would otherwise have
    it consulted on every restore here, and a source that wants credentials it does not have
    prompts or fails the restore — for packages it was never going to supply. Clearing makes the
    restore the same on every machine: this one source and nothing else.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
