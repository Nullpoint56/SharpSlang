+// unit-test-specialization-sized-array-reflection.cpp
+
+#include "slang-com-ptr.h"
+#include "slang.h"
+#include "unit-test/slang-unit-test.h"
+
+using namespace Slang;
+
+// The length of an array sized by a specialization constant is not known until the program is
+// specialized. This test checks that reflection reports such a length as `SLANG_UNKNOWN_SIZE`
+// instead of failing to evaluate it.
+
+static slang::IModule* loadSpecializationSizedArrayModule(
+    slang::IGlobalSession* globalSession,
+    ComPtr<slang::ISession>& outSession,
+    const char* name,
+    const char* source)
+{
+    slang::TargetDesc targetDesc = {};
+    targetDesc.format = SLANG_SPIRV;
+    targetDesc.profile = globalSession->findProfile("spirv_1_5");
+
+    slang::SessionDesc sessionDesc = {};
+    sessionDesc.targetCount = 1;
+    sessionDesc.targets = &targetDesc;
+
+    if (SLANG_FAILED(globalSession->createSession(sessionDesc, outSession.writeRef())))
+        return nullptr;
+
+    ComPtr<slang::IBlob> diagnosticBlob;
+    return outSession->loadModuleFromSourceString(name, name, source, diagnosticBlob.writeRef());
+}
+
+SLANG_UNIT_TEST(specializationSizedArrayElementCount)
+{
+    const char* source = R"(
+        [vk::constant_id(0)] const int kCount = 3;
+
+        struct Block
+        {
+            float4 items[kCount];
+            float tail;
+        }
+
+        ConstantBuffer<Block> gBlock;
+
+        [shader("fragment")]
+        float4 fragmentMain() : SV_Target
+        {
+            return gBlock.items[0] + gBlock.tail;
+        }
+        )";
+
+    ComPtr<slang::IGlobalSession> globalSession;
+    SLANG_CHECK_ABORT(
+        slang_createGlobalSession(SLANG_API_VERSION, globalSession.writeRef()) == SLANG_OK);
+
+    ComPtr<slang::ISession> session;
+    auto module = loadSpecializationSizedArrayModule(
+        globalSession,
+        session,
+        "specializationSizedArrayElementCount",
+        source);
+    SLANG_CHECK_ABORT(module != nullptr);
+
+    auto layout = module->getLayout();
+    SLANG_CHECK_ABORT(layout != nullptr);
+
+    auto blockType = layout->findTypeByName("Block");
+    SLANG_CHECK_ABORT(blockType != nullptr);
+    SLANG_CHECK_ABORT(blockType->getFieldCount() == 2);
+
+    auto arrayType = blockType->getFieldByIndex(0)->getType();
+    SLANG_CHECK_ABORT(arrayType != nullptr);
+    SLANG_CHECK_ABORT(arrayType->getKind() == slang::TypeReflection::Kind::Array);
+
+    SLANG_CHECK(arrayType->getElementCount() == SLANG_UNKNOWN_SIZE);
+    SLANG_CHECK(arrayType->getElementCount((SlangReflection*)layout) == SLANG_UNKNOWN_SIZE);
+}
