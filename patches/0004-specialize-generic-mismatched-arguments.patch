+// unit-test-specialize-generic-mismatch.cpp
+
+#include "slang-com-ptr.h"
+#include "slang.h"
+#include "unit-test/slang-unit-test.h"
+
+using namespace Slang;
+
+// This test exercises the public `specializeGeneric` API with argument lists that do not match
+// the generic's parameters: a value where a type parameter belongs, and more arguments than
+// parameters. The API should report the mismatch as a diagnostic and return `nullptr`.
+
+static void checkMismatchIsDiagnosed(
+    slang::ProgramLayout* layout,
+    slang::GenericReflection* generic,
+    SlangInt argCount,
+    slang::GenericArgType const* argTypes,
+    slang::GenericArgReflection const* args,
+    const char* expectedDiagnostic)
+{
+    ComPtr<slang::IBlob> diagnosticBlob;
+    auto specialized =
+        layout->specializeGeneric(generic, argCount, argTypes, args, diagnosticBlob.writeRef());
+    SLANG_CHECK(specialized == nullptr);
+    SLANG_CHECK_ABORT(diagnosticBlob != nullptr);
+
+    auto diagnostics = UnownedStringSlice(
+        (const char*)diagnosticBlob->getBufferPointer(),
+        diagnosticBlob->getBufferSize());
+    SLANG_CHECK(diagnostics.indexOf(UnownedStringSlice(expectedDiagnostic)) != -1);
+}
+
+SLANG_UNIT_TEST(specializeGenericMismatchedArguments)
+{
+    const char* source = R"(
+        interface IMaterial
+        {
+            float3 shade(float3 albedo);
+        }
+
+        struct Lambert : IMaterial
+        {
+            float3 shade(float3 albedo) { return albedo; }
+        }
+
+        struct Wrapper<T : IMaterial>
+        {
+            T inner;
+            float4 tint;
+        }
+        )";
+
+    ComPtr<slang::IGlobalSession> globalSession;
+    SLANG_CHECK_ABORT(
+        slang_createGlobalSession(SLANG_API_VERSION, globalSession.writeRef()) == SLANG_OK);
+
+    slang::TargetDesc targetDesc = {};
+    targetDesc.format = SLANG_SPIRV;
+    targetDesc.profile = globalSession->findProfile("spirv_1_5");
+
+    slang::SessionDesc sessionDesc = {};
+    sessionDesc.targetCount = 1;
+    sessionDesc.targets = &targetDesc;
+
+    ComPtr<slang::ISession> session;
+    SLANG_CHECK_ABORT(globalSession->createSession(sessionDesc, session.writeRef()) == SLANG_OK);
+
+    ComPtr<slang::IBlob> diagnosticBlob;
+    auto module = session->loadModuleFromSourceString(
+        "specializeGenericMismatchedArguments",
+        "specializeGenericMismatchedArguments.slang",
+        source,
+        diagnosticBlob.writeRef());
+    SLANG_CHECK_ABORT(module != nullptr);
+
+    auto layout = module->getLayout();
+    SLANG_CHECK_ABORT(layout != nullptr);
+
+    auto wrapperType = layout->findTypeByName("Wrapper");
+    SLANG_CHECK_ABORT(wrapperType != nullptr);
+    auto generic = wrapperType->getGenericContainer();
+    SLANG_CHECK_ABORT(generic != nullptr);
+
+    auto lambertType = layout->findTypeByName("Lambert");
+    SLANG_CHECK_ABORT(lambertType != nullptr);
+
+    // A value where the type parameter belongs.
+    {
+        slang::GenericArgType argType = slang::GenericArgType::SLANG_GENERIC_ARG_INT;
+        slang::GenericArgReflection arg = {};
+        arg.intVal = 3;
+        checkMismatchIsDiagnosed(layout, generic, 1, &argType, &arg, "expected a type");
+    }
+
+    // Two type arguments for one type parameter.
+    {
+        slang::GenericArgType argTypes[] = {
+            slang::GenericArgType::SLANG_GENERIC_ARG_TYPE,
+            slang::GenericArgType::SLANG_GENERIC_ARG_TYPE,
+        };
+        slang::GenericArgReflection args[2] = {};
+        args[0].typeVal = lambertType;
+        args[1].typeVal = lambertType;
+        checkMismatchIsDiagnosed(layout, generic, 2, argTypes, args, "too many arguments");
+    }
+}
