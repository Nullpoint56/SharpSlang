+    // The session's file system caches what it has read, and its source manager keeps the files it
+    // loaded, so reading the dependencies through them answers for the files as this session first
+    // read them: a source rewritten since, or one reached through a path that does not exist, still
+    // matches. The dependencies are read through a new cache over the same underlying file system
+    // and a source manager of their own, as a new session would read them. A file system the caller
+    // supplied as a CacheFileSystem is the caller's own cache, and is read as it is.
+    //
+    ComPtr<ISlangFileSystemExt> freshFileSystem;
+    if (!m_fileSystem)
+        freshFileSystem = new CacheFileSystem(OSFileSystem::getExtSingleton());
+    else if (as<CacheFileSystem>(m_fileSystem))
+        freshFileSystem = getFileSystemExt();
+    else
+        freshFileSystem = new CacheFileSystem(m_fileSystem);
+    SourceManager freshSourceManager;
+    freshSourceManager.initialize(nullptr, freshFileSystem);
+    IncludeSystem freshIncludeSystem(&getSearchDirectories(), freshFileSystem, &freshSourceManager);
+    auto loadFreshSourceFile = [&](const String& pathFrom, const String& path) -> SourceFile*
+    {
+        ComPtr<slang::IBlob> blob;
+        PathInfo pathInfo;
+        SourceFile* sourceFile = nullptr;
+        if (SLANG_FAILED(freshIncludeSystem.findFile(path, pathFrom, pathInfo)) ||
+            SLANG_FAILED(freshIncludeSystem.loadFile(pathInfo, blob, sourceFile)))
+            return nullptr;
+        return sourceFile;
+    };
