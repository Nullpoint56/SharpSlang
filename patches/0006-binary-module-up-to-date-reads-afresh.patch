+// unit-test-binary-module-up-to-date.cpp
+
+#include "core/slang-io.h"
+#include "slang-com-ptr.h"
+#include "slang.h"
+#include "unit-test/slang-unit-test.h"
+
+using namespace Slang;
+
+// This test serializes a module loaded from a file, rewrites the file, and asks the same session
+// whether the serialized module is still up to date. The session that loaded the module must not
+// answer from the contents it read before the file changed.
+
+SLANG_UNIT_TEST(binaryModuleUpToDateAfterSourceChange)
+{
+    const char* source = "public float4 f() { return float4(1, 2, 3, 4); }\n";
+    const String path = "binaryModuleUpToDateAfterSourceChange.slang";
+    SLANG_CHECK_ABORT(SLANG_SUCCEEDED(File::writeAllText(path, source)));
+
+    ComPtr<slang::IGlobalSession> globalSession;
+    SLANG_CHECK_ABORT(
+        slang_createGlobalSession(SLANG_API_VERSION, globalSession.writeRef()) == SLANG_OK);
+
+    slang::TargetDesc targetDesc = {};
+    targetDesc.format = SLANG_SPIRV;
+    targetDesc.profile = globalSession->findProfile("spirv_1_5");
+
+    const char* searchPath = ".";
+    slang::SessionDesc sessionDesc = {};
+    sessionDesc.targetCount = 1;
+    sessionDesc.targets = &targetDesc;
+    sessionDesc.searchPaths = &searchPath;
+    sessionDesc.searchPathCount = 1;
+
+    ComPtr<slang::ISession> session;
+    SLANG_CHECK_ABORT(globalSession->createSession(sessionDesc, session.writeRef()) == SLANG_OK);
+
+    ComPtr<slang::IBlob> diagnosticBlob;
+    auto module =
+        session->loadModule("binaryModuleUpToDateAfterSourceChange", diagnosticBlob.writeRef());
+    SLANG_CHECK_ABORT(module != nullptr);
+
+    ComPtr<slang::IBlob> serialized;
+    SLANG_CHECK_ABORT(SLANG_SUCCEEDED(module->serialize(serialized.writeRef())));
+    SLANG_CHECK(session->isBinaryModuleUpToDate(path.getBuffer(), serialized));
+
+    SLANG_CHECK_ABORT(SLANG_SUCCEEDED(File::writeAllText(path, String(source) + "// changed\n")));
+    SLANG_CHECK(!session->isBinaryModuleUpToDate(path.getBuffer(), serialized));
+
+    File::remove(path);
+}
