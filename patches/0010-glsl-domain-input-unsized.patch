+IRType* GLSLSourceEmitter::getGlobalParamDeclaredType(IRGlobalParam* varDecl, IRType* varType)
+{
+    // GLSL requires the per-vertex inputs of the tessellation control and evaluation shaders to be
+    // declared implicitly sized (or sized gl_MaxPatchVertices); declared with the patch's size, as
+    // the hull shader's `InputPatch<T, N>` and the domain shader's `OutputPatch<T, N>` legalize
+    // them, they are an error. The size stays in the IR, where legalization and layout use it, and
+    // only the declaration drops it. Per-patch inputs carry the `patch` decoration, and system
+    // values are built in.
+    //
+    if (m_entryPointStage != Stage::Hull && m_entryPointStage != Stage::Domain)
+        return varType;
+    auto arrayType = as<IRArrayType>(varType);
+    if (!arrayType)
+        return varType;
+    auto ptrType = as<IRPtrTypeBase>(varDecl->getDataType());
+    if (!ptrType || ptrType->getAddressSpace() != AddressSpace::Input)
+        return varType;
+    if (varDecl->findDecoration<IRGLSLPatchDecoration>())
+        return varType;
+    if (auto layout = getVarLayout(varDecl))
+    {
+        if (layout->findSystemValueSemanticAttr())
+            return varType;
+    }
+    IRBuilder builder(varDecl);
+    return builder.getUnsizedArrayType(arrayType->getElementType());
+}
