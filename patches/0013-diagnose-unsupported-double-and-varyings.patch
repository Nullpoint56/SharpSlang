+++ b/tools/slang-unit-test/unit-test-unsupported-construct-diagnosed.cpp
@@ -0,0 +1,83 @@
+// unit-test-unsupported-construct-diagnosed.cpp
+
+#include "slang-com-ptr.h"
+#include "slang.h"
+#include "unit-test/slang-unit-test.h"
+
+using namespace Slang;
+
+// A construct a target cannot express should end compilation with a diagnostic naming it, not with
+// an internal error: `double` on WGSL and Metal (E56110), and a rasterization stage's varying
+// parameters on the C++ target (E56111).
+
+static void checkDiagnosed(
+    slang::IGlobalSession* globalSession,
+    SlangCompileTarget format,
+    const char* source,
+    const char* entryPointName,
+    const char* expectedCode)
+{
+    slang::TargetDesc targetDesc = {};
+    targetDesc.format = format;
+
+    slang::SessionDesc sessionDesc = {};
+    sessionDesc.targetCount = 1;
+    sessionDesc.targets = &targetDesc;
+
+    ComPtr<slang::ISession> session;
+    SLANG_CHECK_ABORT(globalSession->createSession(sessionDesc, session.writeRef()) == SLANG_OK);
+
+    ComPtr<slang::IBlob> diagnostics;
+    auto module = session->loadModuleFromSourceString(
+        "unsupportedConstructDiagnosed",
+        "unsupportedConstructDiagnosed.slang",
+        source,
+        diagnostics.writeRef());
+    SLANG_CHECK_ABORT(module != nullptr);
+
+    ComPtr<slang::IEntryPoint> entryPoint;
+    SLANG_CHECK_ABORT(
+        SLANG_SUCCEEDED(module->findEntryPointByName(entryPointName, entryPoint.writeRef())));
+    slang::IComponentType* components[] = {module, entryPoint};
+    ComPtr<slang::IComponentType> program;
+    SLANG_CHECK_ABORT(SLANG_SUCCEEDED(session->createCompositeComponentType(
+        components,
+        2,
+        program.writeRef(),
+        diagnostics.writeRef())));
+    ComPtr<slang::IComponentType> linked;
+    SLANG_CHECK_ABORT(SLANG_SUCCEEDED(program->link(linked.writeRef(), diagnostics.writeRef())));
+
+    ComPtr<slang::IBlob> code;
+    diagnostics = nullptr;
+    auto result = linked->getEntryPointCode(0, 0, code.writeRef(), diagnostics.writeRef());
+    SLANG_CHECK(SLANG_FAILED(result));
+    SLANG_CHECK_ABORT(diagnostics != nullptr);
+    auto text = UnownedStringSlice(
+        (const char*)diagnostics->getBufferPointer(),
+        diagnostics->getBufferSize());
+    SLANG_CHECK(text.indexOf(UnownedStringSlice(expectedCode)) != -1);
+    SLANG_CHECK(text.indexOf(UnownedStringSlice("E9999")) == -1);
+}
+
+SLANG_UNIT_TEST(unsupportedConstructDiagnosed)
+{
+    ComPtr<slang::IGlobalSession> globalSession;
+    SLANG_CHECK_ABORT(
+        slang_createGlobalSession(SLANG_API_VERSION, globalSession.writeRef()) == SLANG_OK);
+
+    const char* doubleSource = R"(
+        RWStructuredBuffer<double> result;
+        [shader("compute")]
+        [numthreads(1, 1, 1)]
+        void computeMain() { result[0] = 1.0l; }
+        )";
+    checkDiagnosed(globalSession, SLANG_WGSL, doubleSource, "computeMain", "56110");
+    checkDiagnosed(globalSession, SLANG_METAL, doubleSource, "computeMain", "56110");
+
+    const char* fragmentSource = R"(
+        [shader("fragment")]
+        float4 fragmentMain(float4 position : SV_Position) : SV_Target { return position; }
+        )";
+    checkDiagnosed(globalSession, SLANG_CPP_SOURCE, fragmentSource, "fragmentMain", "56111");
+}
