+// unit-test-specialization-sized-constant-buffer-binding.cpp
+
+#include "slang-com-ptr.h"
+#include "slang.h"
+#include "unit-test/slang-unit-test.h"
+
+using namespace Slang;
+
+// A constant buffer whose block holds only an array sized by a specialization constant has a size
+// that is not known until specialization, and it must still be given a binding.
+
+SLANG_UNIT_TEST(specializationSizedConstantBufferBinding)
+{
+    const char* source = R"(
+        [vk::constant_id(0)] const int kCount = 4;
+        struct Block { float4 values[kCount]; };
+        ConstantBuffer<Block> gUnsized;
+
+        [shader("fragment")]
+        float4 fragmentMain() : SV_Target { return gUnsized.values[0]; }
+        )";
+
+    ComPtr<slang::IGlobalSession> globalSession;
+    SLANG_CHECK_ABORT(
+        slang_createGlobalSession(SLANG_API_VERSION, globalSession.writeRef()) == SLANG_OK);
+
+    slang::TargetDesc targetDesc = {};
+    targetDesc.format = SLANG_SPIRV;
+    targetDesc.profile = globalSession->findProfile("spirv_1_5");
+
+    slang::SessionDesc sessionDesc = {};
+    sessionDesc.targetCount = 1;
+    sessionDesc.targets = &targetDesc;
+
+    ComPtr<slang::ISession> session;
+    SLANG_CHECK_ABORT(globalSession->createSession(sessionDesc, session.writeRef()) == SLANG_OK);
+
+    ComPtr<slang::IBlob> diagnostics;
+    auto module = session->loadModuleFromSourceString(
+        "specializationSizedConstantBufferBinding",
+        "specializationSizedConstantBufferBinding.slang",
+        source,
+        diagnostics.writeRef());
+    SLANG_CHECK_ABORT(module != nullptr);
+
+    auto layout = module->getLayout(0, diagnostics.writeRef());
+    SLANG_CHECK_ABORT(layout != nullptr);
+    // The specialization constant is a global parameter too; the buffer is found by name.
+    slang::VariableLayoutReflection* parameter = nullptr;
+    for (unsigned i = 0; i < layout->getParameterCount(); ++i)
+    {
+        auto candidate = layout->getParameterByIndex(i);
+        if (candidate->getName() && UnownedStringSlice(candidate->getName()) == "gUnsized")
+            parameter = candidate;
+    }
+    SLANG_CHECK_ABORT(parameter != nullptr);
+    SLANG_CHECK(parameter->getCategoryCount() > 0);
+    SLANG_CHECK(parameter->getTypeLayout()->getDescriptorSetCount() + parameter->getCategoryCount() > 0);
+}
