diff --git a/source/slang/slang-linkable.cpp b/source/slang/slang-linkable.cpp
index 3098cfcc0..6d0f68edc 100644
--- a/source/slang/slang-linkable.cpp
+++ b/source/slang/slang-linkable.cpp
@@ -596,6 +596,23 @@ SLANG_NO_THROW SlangResult SLANG_MCALL ComponentType::linkWithOptions(
     }
     linked->getOptionSet().load(count, entries);
 
+    // A target's capabilities and profile are fixed when the session creates the target request,
+    // and code generation reads them from there, so these options given here change nothing.
+    //
+    DiagnosticSink sink(getLinkage()->getSourceManager(), Lexer::sourceLocationLexer);
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        if (entries[i].name == slang::CompilerOptionName::Capability ||
+            entries[i].name == slang::CompilerOptionName::Profile)
+        {
+            sink.diagnose(Diagnostics::LinkTimeOptionHasNoEffect{
+                .option = entries[i].name == slang::CompilerOptionName::Capability ? "Capability"
+                                                                                   : "Profile"});
+        }
+    }
+    if (outDiagnostics && sink.outputBuffer.getLength() > 0)
+        sink.getBlobIfNeeded(outDiagnostics);
+
     *outLinkedComponentType = ComPtr<slang::IComponentType>(linked).detach();
     return SLANG_OK;
 }
