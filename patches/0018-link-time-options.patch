+HLSLToVulkanLayoutOptions* TargetProgram::getHLSLToVulkanLayoutOptions()
+{
+    // The target request's options are built from the session's and the target's option sets. Options
+    // given to `linkWithOptions` live on the program, and `m_optionSet` merges them over the target's;
+    // reading the target request's options alone dropped them (`VulkanUseEntryPointName` given at
+    // link time changed nothing).
+    //
+    if (m_program->getOptionSet().options.getCount() == 0)
+        return m_targetReq->getHLSLToVulkanLayoutOptions();
+
+    std::lock_guard<std::mutex> lock(m_hlslToVulkanLayoutOptionsMutex);
+    if (!m_hlslToVulkanLayoutOptions)
+    {
+        m_hlslToVulkanLayoutOptions = new HLSLToVulkanLayoutOptions();
+        m_hlslToVulkanLayoutOptions->loadFromOptionSet(m_optionSet);
+    }
+    return m_hlslToVulkanLayoutOptions.get();
+}
