+// unit-test-parameter-block-space-offset.cpp
+
+#include "slang-com-ptr.h"
+#include "slang.h"
+#include "unit-test/slang-unit-test.h"
+
+using namespace Slang;
+
+// A top-level parameter block's sub-object range reports the space the block occupies.
+
+SLANG_UNIT_TEST(parameterBlockSpaceOffset)
+{
+    const char* source = R"(
+        struct Material { float4 tint; Texture2D albedo; };
+        Texture2D loose;
+        ParameterBlock<Material> first;
+        ParameterBlock<Material> second;
+        SamplerState samp;
+
+        [shader("fragment")]
+        float4 fragmentMain(float2 uv : TEXCOORD0) : SV_Target
+        {
+            return loose.Sample(samp, uv) + first.tint + first.albedo.Sample(samp, uv) +
+                   second.tint + second.albedo.Sample(samp, uv);
+        }
+        )";
+
+    ComPtr<slang::IGlobalSession> globalSession;
+    SLANG_CHECK_ABORT(
+        slang_createGlobalSession(SLANG_API_VERSION, globalSession.writeRef()) == SLANG_OK);
+
+    slang::TargetDesc targetDesc = {};
+    targetDesc.format = SLANG_SPIRV;
+    targetDesc.profile = globalSession->findProfile("spirv_1_5");
+
+    slang::SessionDesc sessionDesc = {};
+    sessionDesc.targetCount = 1;
+    sessionDesc.targets = &targetDesc;
+
+    ComPtr<slang::ISession> session;
+    SLANG_CHECK_ABORT(globalSession->createSession(sessionDesc, session.writeRef()) == SLANG_OK);
+
+    ComPtr<slang::IBlob> diagnostics;
+    auto module = session->loadModuleFromSourceString(
+        "parameterBlockSpaceOffset",
+        "parameterBlockSpaceOffset.slang",
+        source,
+        diagnostics.writeRef());
+    SLANG_CHECK_ABORT(module != nullptr);
+
+    auto layout = module->getLayout(0, diagnostics.writeRef());
+    SLANG_CHECK_ABORT(layout != nullptr);
+    auto globals = layout->getGlobalParamsTypeLayout();
+    SLANG_CHECK_ABORT(globals != nullptr);
+    SLANG_CHECK_ABORT(globals->getSubObjectRangeCount() == 2);
+    SLANG_CHECK(globals->getSubObjectRangeSpaceOffset(0) == 1);
+    SLANG_CHECK(globals->getSubObjectRangeSpaceOffset(1) == 2);
+}
