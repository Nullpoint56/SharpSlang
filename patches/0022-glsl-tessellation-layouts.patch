index 4b33c21..6d5834c 100644
--- a/source/slang/slang-emit-glsl.cpp
+++ b/source/slang/slang-emit-glsl.cpp
@@ -1677,6 +1677,32 @@ void GLSLSourceEmitter::emitEntryPointAttributesImpl(
                 }
             }
             break;
+        case Stage::Hull:
+            // GLSL declares the number of output control points on the tessellation control
+            // shader, where HLSL has `[outputcontrolpoints(N)]`.
+            if (auto decor = as<IROutputControlPointsDecoration>(decoration))
+            {
+                m_writer->emit("layout(vertices = ");
+                m_writer->emit(Int(getIntVal(decor->getControlPointCount())));
+                m_writer->emit(") out;\n");
+            }
+            break;
+        case Stage::Domain:
+            // GLSL declares the abstract patch on the tessellation evaluation shader, where HLSL has
+            // `[domain(...)]`. The spacing and the vertex order, which GLSL also takes here, are the
+            // hull shader's attributes in HLSL and are not known to a domain shader compiled alone;
+            // GLSL's defaults (`equal_spacing`, `ccw`) apply.
+            if (auto decor = as<IRDomainDecoration>(decoration))
+            {
+                auto domain = decor->getDomain()->getStringSlice();
+                if (domain.startsWithCaseInsensitive(toSlice("tri")))
+                    m_writer->emit("layout(triangles) in;\n");
+                else if (domain.caseInsensitiveEquals(toSlice("quad")))
+                    m_writer->emit("layout(quads) in;\n");
+                else if (domain.caseInsensitiveEquals(toSlice("isoline")))
+                    m_writer->emit("layout(isolines) in;\n");
+            }
+            break;
         case Stage::Pixel:
