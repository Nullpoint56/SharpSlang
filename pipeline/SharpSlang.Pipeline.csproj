<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SharpSlang.Pipeline — everything a shipped game needs, and nothing that needs the compiler.

    The split exists because the two halves have opposite deployment stories. Compiling a shader
    needs slang-compiler, which is 36 MB per RID; *reading* a shader that was already compiled needs
    a container reader, a reflection snapshot and a Vulkan projection, all of which are plain
    managed data. A game that cooks its shaders offline should reference this and never see the
    payload — see docs .

    What lives here:
      ShaderPackage.cs   the container: ReadFrom/WriteTo, staleness checks. Baking a *new* one needs
                         a LinkedProgram, so ShaderPackageBaker stays on the compiler side.
      ProgramLayout.cs   the reflection snapshot and everything it exposes.
      TypeLayout.cs      the type tree.
      SpirvModule.cs     the emitted-module reader. Byte parsing; it never needed Slang.

    The generated enums the surface above names (SlangStage, SlangParameterCategory, ...) are
    SharpSlang.Descs': L0 without its DllImport file, no native dependency (../NativeSplit.props),
    referenced exactly.

    The test for whether something belongs: does it hold a pointer, or call a Slang function? If
    yes it stays in SharpSlang. The acceptance test in tests/SharpSlang.Pipeline.Consumer is what
    keeps that honest — it references this and asserts its own build output has no native payload
    in it at all.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SharpSlang</RootNamespace>

    <!-- Trimming and Native AOT: declared, so the trim, AOT and single-file analyzers run in every build (errors under -warnaserror), and tools/consume publishes it with Native AOT (AGENTS.md#native-packages) -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>SharpSlang.Pipeline</PackageId>
    <Version>$(SharpSlangPipelineVersion)</Version>
    <Description>Reads what SharpSlang baked: shader package container, reflection snapshot, and SPIR-V module header. No native dependency: reference this from the application that loads baked packages, and leave the compiler and its per-platform payload in the asset pipeline.</Description>
    <PackageTags>slang;shader;spirv;reflection;shader-package</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\descs\SharpSlang.Descs.csproj" />
  </ItemGroup>

  <!--
    No InternalsVisibleTo for SharpSlang: SharpSlang reaches this assembly through its public
    surface only. The tests keep it, so a reader-side invariant can be asserted without widening the
    API to make it assertable.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SharpSlang.Tests" />
  </ItemGroup>

</Project>
