<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke-test host. Becomes the Tier 0 vertical spike described in AGENTS.md#test-runner:
    global session -> load a .slang module -> entry point -> link -> SPIR-V.
    Right now it only proves the native library resolves and the P/Invoke path is live.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The cooker for the reflection snapshot and the SPIR-V reader, a cooker's references. -->
  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\SharpSlang.csproj" />
    <ProjectReference Include="..\..\bake\SharpSlang.Pipeline.Bake.csproj" />
  </ItemGroup>

</Project>
