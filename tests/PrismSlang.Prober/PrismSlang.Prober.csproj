<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A child process for the reflection calls that do not fail — they end.

     found that reflecting a resource array sized by a specialization constant terminates the
    process inside spReflectionTypeLayout_getBindingRangeCount: no exception, no managed stack, no
    diagnostic. A test cannot assert that in-process, because asserting it is fatal to the runner,
    so the construct sat in the documentation as a sentence nothing checked.

    Here it is a program. LifetimeTests spawns it and reads the exit code, which turns "we believe
    this kills the process" into a test — and, more usefully, turns the day Slang fixes it into a
    failing test rather than into nothing at all.

    Not a sample and not shipped: IsPackable is off and nothing references it.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- One case reaches past the managed guard to the flat API it guards; that needs pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>PrismSlang.Prober</RootNamespace>
    <AssemblyName>PrismSlang.Prober</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\PrismSlang.csproj" />
  </ItemGroup>

  <!--
    dxc beside the prober, as the test project has it and for the same reason: the
    downstream-compilers case compiles DXIL wherever dxcompiler.dll is in its output, which is a
    win-x64 host. That case is launched as `dotnet PrismSlang.Prober.dll` from another directory,
    where Slang's own by-name LoadLibrary finds neither dxc nor slang-glslang, so it is what shows
    CompanionLibraries finding them. Microsoft's package and the targets file that
    PrismSlang.Native.Dxc ships, restated because a referenced project's build/ targets never
    import.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Direct3D.DXC" Version="[$(DxcPackageVersion)]" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\..\native\build\PrismSlang.Native.Dxc.targets" />

</Project>
