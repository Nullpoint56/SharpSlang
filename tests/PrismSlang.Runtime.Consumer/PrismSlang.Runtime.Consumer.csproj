<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The acceptance criterion for the assembly split, written as a project rather than as a claim.

    It references PrismSlang.Runtime and PrismSlang.Vulkan and NOTHING ELSE — no PrismSlang, no
    Vortice, no test framework. If either of those ever picks up a transitive edge to the compiler,
    slang-compiler.dll and the runtimes/ tree land in this project's output, and
    AssemblySplitTests notices.

    It is an exe rather than a library so that it produces the real deployment closure a game would
    get, including everything a ProjectReference copies flat.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>PrismSlang.Runtime.Consumer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\runtime\PrismSlang.Runtime.csproj" />
    <ProjectReference Include="..\..\vulkan\PrismSlang.Vulkan.csproj" />
  </ItemGroup>

</Project>
