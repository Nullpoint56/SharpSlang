<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drift tests. These do not test Slang and they do not need the native library — they test that
    the hand-written parts of the binding still agree with the pinned slang.h. Everything they
    assert is re-derived from the header at run time, never restated, so they fail on an upstream
    change instead of passing forever. See docs/design.md §4.5.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <AssemblyName>PrismSlang.Tests</AssemblyName>
  </PropertyGroup>

  <!-- Surfaces the pinned version from Directory.Build.props to the test code. -->
  <ItemGroup>
    <AssemblyMetadata Include="SlangVersion" Value="$(SlangVersion)" />

    <!--
      Where the native-free consumer builds to. AssemblySplitTests inspects that directory rather
      than reasoning about project references, because what the engine team asked for is a property
      of the deployment closure and nothing else demonstrates it.
    -->
    <AssemblyMetadata Include="RuntimeConsumerOutput"
                      Value="$(MSBuildThisFileDirectory)..\PrismSlang.Runtime.Consumer\bin\$(Configuration)\$(TargetFramework)" />

    <!--
      Where the crash prober builds to. ProberTests launches it as a child process, because the
      reflection call it performs does not throw — it ends the process, and there is no way to
      assert that from inside the runner it would take down with it. See docs/guide.md .
    -->
    <AssemblyMetadata Include="ProberOutput"
                      Value="$(MSBuildThisFileDirectory)..\PrismSlang.Prober\bin\$(Configuration)\$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!--
      Renders an assembly's public surface as C#. Three packages carry a semver promise the moment
      one of them is 1.0, and nothing was checking the promise: a member could be removed, a
      parameter reordered or a type made internal, and the only signal would be a consumer's build
      breaking. The approved files beside PublicApiTests are that signal, moved to review time.
    -->
    <PackageReference Include="PublicApiGenerator" Version="11.4.6" />

    <!--
      The oracle for VulkanEnums, and the only reason this dependency exists. PrismSlang.Vulkan
      mirrors ~48 Vulkan enum values by hand so that it ships standalone — a consumer should not
      inherit somebody else's choice of Vulkan binding behind a small mapping. That reasoning is
      about the *package*, and it says nothing about the test assembly, which can depend on
      whatever gives it a real answer.

      Vortice.Vulkan is generated from the Khronos vk.xml registry, so agreeing with it is
      agreeing with the specification. See VulkanEnumTests, and docs .
    -->
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
  </ItemGroup>

  <!--
    The device behind the NRI projection, and the same reasoning as Vortice above: the package
    references PrismNRI.Descs and nothing with a native library in it, so that a cooker can project
    on a machine with no driver, while the tests can carry whatever gives them a real answer.
    PrismNRI is NRI itself, which creates the pipeline layouts and pipelines the projection
    describes; PrismNRI.Testing is its validated headless device, with NRI's own validation and the
    Vulkan layers on and every message recorded.

    Both from where Directory.Build.props says PrismNRI comes from (PrismNriSource): the release
    pinned there, from the folder feed tools/fetch-nri.ps1 fills, or the projects of a PrismNRI
    checkout beside this repository. The packages put NRI.dll under runtimes/ and name it in
    deps.json; the projects copy the host RID's NRI.dll flat into this output.
  -->
  <ItemGroup Condition="'$(PrismNriSource)' == 'package'">
    <PackageReference Include="PrismNRI" Version="[$(PrismNriVersion)]" />
    <PackageReference Include="PrismNRI.Testing" Version="[$(PrismNriVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(PrismNriSource)' == 'project'">
    <ProjectReference Include="$(PrismNriRootFull)dotnet\PrismNRI.csproj" />
    <ProjectReference Include="$(PrismNriRootFull)testing\PrismNRI.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\PrismSlang.csproj" />
    <ProjectReference Include="..\..\vulkan\PrismSlang.Vulkan.csproj" />
    <ProjectReference Include="..\..\nri\PrismSlang.NRI.csproj" />

    <!--
      Built, never referenced. AssemblySplitTests needs the consumer's output directory to exist and
      to be current; referencing its assembly would pull it into this project's own closure, where
      the compiler payload lives, and there would be nothing left to measure.
    -->
    <ProjectReference Include="..\PrismSlang.Runtime.Consumer\PrismSlang.Runtime.Consumer.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />

    <!-- Same arrangement, for the same reason: built so ProberTests can spawn it, not linked. -->
    <ProjectReference Include="..\PrismSlang.Prober\PrismSlang.Prober.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />

  </ItemGroup>

  <!--
    dxc beside the compiler, for the DXIL tests, the way a consumer of PrismSlang.Native.Dxc gets
    it: Microsoft's own package at the pinned version, and the targets file that package ships
    copying dxcompiler.dll and dxil.dll into the output on a win-x64 host. A ProjectReference to
    native/PrismSlang.Native.Dxc.csproj would not do it — a referenced project's build/ targets
    are a package asset and never import — so the package reference and the import are restated
    here, and the import is the very file the package carries. On any other host the targets
    copy nothing and the DXIL tests skip with the reason.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Direct3D.DXC" Version="[$(DxcPackageVersion)]" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\..\native\build\PrismSlang.Native.Dxc.targets" />

</Project>
