<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drift tests. These do not test Slang and they do not need the native library — they test that
    the hand-written parts of the binding still agree with the pinned slang.h. Everything they
    assert is re-derived from the header at run time, never restated, so they fail on an upstream
    change instead of passing forever. See docs/binding-surface.md §4.5.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <AssemblyName>PrismSlang.Tests</AssemblyName>
  </PropertyGroup>

  <!-- Surfaces the pinned version from Directory.Build.props to the test code. -->
  <ItemGroup>
    <AssemblyMetadata Include="SlangVersion" Value="$(SlangVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />

    <!--
      The oracle for VulkanEnums, and the only reason this dependency exists. PrismSlang.Vulkan
      mirrors ~48 Vulkan enum values by hand so that it ships standalone — a consumer should not
      inherit somebody else's choice of Vulkan binding behind a small mapping. That reasoning is
      about the *package*, and it says nothing about the test assembly, which can depend on
      whatever gives it a real answer.

      Vortice.Vulkan is generated from the Khronos vk.xml registry, so agreeing with it is
      agreeing with the specification. See VulkanEnumTests, and docs §9.14.
    -->
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\PrismSlang.csproj" />
    <ProjectReference Include="..\..\vulkan\PrismSlang.Vulkan.csproj" />
  </ItemGroup>

</Project>
