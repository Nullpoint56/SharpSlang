<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    The consumer's own, so it restores the packages under test and nothing else.

    artifacts/ is where publish.yml packs the five packages; nuget.org supplies
    Microsoft.Direct3D.DXC, which SharpSlang.Dxc depends on. <clear/> for the reason the
    repository's nuget.config gives, and so that a SharpSlang feed configured machine-wide can never
    stand in for the packages just packed.

    The packages folder is this project's own, under obj/, because the packages under test carry a
    version that does not change from one pack to the next: a global cache that already held
    SharpSlang 0.1.0-alpha from an earlier pack would restore that copy, and the check would pass or
    fail on a package nobody just built. publish.yml deletes obj/ before it builds.
  -->
  <config>
    <add key="globalPackagesFolder" value="obj/packages" />
  </config>

  <packageSources>
    <clear />
    <add key="artifacts" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
