<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drift tests. These do not test Slang and they do not need the native library — they test that
    the hand-written parts of the binding still agree with the pinned slang.h. Everything they
    assert is re-derived from the header at run time, never restated, so they fail on an upstream
    change instead of passing forever. See AGENTS.md#descriptor-defaults-and-result-codes.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- A Microsoft.Testing.Platform executable (xunit.v3): global.json makes dotnet test use it. -->
    <OutputType>Exe</OutputType>
    <AssemblyName>SharpSlang.Tests</AssemblyName>
  </PropertyGroup>

  <!-- Surfaces the pinned version from Directory.Build.props to the test code. -->
  <ItemGroup>
    <AssemblyMetadata Include="SlangVersion" Value="$(SlangVersion)" />

    <!--
      Where the native-free consumer builds to. AssemblySplitTests inspects that directory rather
      than reasoning about project references, because what the acceptance criterion asks for is a property
      of the deployment closure and nothing else demonstrates it.
    -->
    <AssemblyMetadata Include="RuntimeConsumerOutput"
                      Value="$(MSBuildThisFileDirectory)..\SharpSlang.Pipeline.Consumer\bin\$(Configuration)\$(TargetFramework)" />

    <!--
      Where the crash prober builds to. ProberTests launches it as a child process, because the
      reflection call it performs does not throw — it ends the process, and there is no way to
      assert that from inside the runner it would take down with it. See docs/guide.md .
    -->
    <AssemblyMetadata Include="ProberOutput"
                      Value="$(MSBuildThisFileDirectory)..\SharpSlang.Prober\bin\$(Configuration)\$(TargetFramework)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Tests run one at a time: xunit.runner.json turns off collection and assembly parallelism.

    Not a performance oversight. Two kinds of state in this suite are process-global and cannot be
    scoped to a test:

      * SlangDiagnostics.Policy and .Handler. Slang's diagnostics are per-call, with no session
        object to hang a policy off, so redirecting them is necessarily a static. Two collections
        running concurrently would see each other's handlers: a test asserting "exactly one warning"
        would intermittently see zero or two, depending on what else happened to compile.

      * The Slang compiler itself. Several tests measure emitted byte sizes to prove an option took
        effect, and Slang caches downstream-compiler state per process.

    Serialising costs a couple of seconds on a suite that already spends most of its time in the
    native compiler. A flaky test costs more than that the first time someone has to decide whether
    to believe it. (It was [assembly: CollectionBehavior(DisableTestParallelization = true)], which
    xunit.v3 refuses.)
  -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    tools/coverage.ps1 builds with -p:SharpSlangCoverage=true and collects test coverage through
    this extension (dotnet test with coverage, cobertura). Off otherwise: Microsoft .NET Library
    licence, test-only, not shipped, and no native collector for every RID.
  -->
  <ItemGroup Condition="'$(SharpSlangCoverage)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      xunit.v3 on Microsoft.Testing.Platform, which the coverage collection of tools/coverage.ps1 needs;
      xunit.runner.visualstudio keeps the IDE's test explorer.
    -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />

    <!--
      Renders an assembly's public surface as C#. The packages carry a semver promise the moment
      one of them is 1.0, and nothing was checking the promise: a member could be removed, a
      parameter reordered or a type made internal, and the only signal would be a consumer's build
      breaking. The approved files beside PublicApiTests are that signal, moved to review time.
    -->
    <PackageReference Include="PublicApiGenerator" Version="11.4.6" />
  </ItemGroup>

  <!--
    The device behind the NRI projection. The package references SharpNRI.Descs and nothing with a
    native library in it, so that a cooker can project on a machine with no driver, while the tests
    can carry whatever gives them a real answer.
    SharpNRI is NRI itself, which creates the pipeline layouts and pipelines the projection
    describes; SharpNRI.Testing is its validated headless device, with NRI's own validation and the
    Vulkan layers on and every message recorded. Both from nuget.org at the version pinned in
    Directory.Build.props, as exact ranges; NRI.dll and libNRI.so come under runtimes/ and are
    named in deps.json.

    No SharpNRI.AgilitySDK: the D3D12 tests run on the D3D12 runtime Windows ships, as they always
    have. Measured with SharpNRI 191.0.0-beta.4 on an RTX 4070 SUPER and on WARP, with and without
    it: the same tests pass with the same outcomes either way. Without it every D3D12 device logs
    one NRI warning, CheckFeatureSupport(options22) failing on the older runtime. With it, in this
    Release build, the debug layer is not copied (SharpNRIAgilityDebugLayer is true only in Debug)
    and D3D12 validation goes silently off: no debug-layer message at all, and every test still
    green. With the debug layer copied too, each device logs about 33 warnings that
    CheckFeatureSupport is superseded (message 989). So the package would add a switch to get right
    and about a thousand warnings to a run of NriDeviceTests, and change no result.
  -->
  <ItemGroup>
    <PackageReference Include="SharpNRI" Version="[$(SharpNriPackageVersion)]" />
    <PackageReference Include="SharpNRI.Testing" Version="[$(SharpNriPackageVersion)]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\dotnet\SharpSlang.csproj" />
    <ProjectReference Include="..\..\bake\SharpSlang.Pipeline.Bake.csproj" />
    <ProjectReference Include="..\..\pipeline-nri\SharpSlang.Pipeline.NRI.csproj" />

    <!--
      Built, never referenced. AssemblySplitTests needs the consumer's output directory to exist and
      to be current; referencing its assembly would pull it into this project's own closure, where
      the compiler payload lives, and there would be nothing left to measure.
    -->
    <ProjectReference Include="..\SharpSlang.Pipeline.Consumer\SharpSlang.Pipeline.Consumer.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />

    <!-- Same arrangement, for the same reason: built so ProberTests can spawn it, not linked. -->
    <ProjectReference Include="..\SharpSlang.Prober\SharpSlang.Prober.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />

  </ItemGroup>

  <!--
    dxc beside the compiler, for the DXIL tests, the way a consumer of SharpSlang.Dxc gets
    it: Microsoft's own package at the pinned version, and the targets file that package ships
    copying dxcompiler.dll and dxil.dll into the output on a win-x64 host. A ProjectReference to
    dxc/SharpSlang.Dxc.csproj would not do it — a referenced project's build/ targets
    are a package asset and never import — so the package reference and the import are restated
    here, and the import is the very file the package carries. On any other host the targets
    copy nothing and the DXIL tests skip with the reason.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Direct3D.DXC" Version="[$(DxcPackageVersion)]" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\..\dxc\buildTransitive\SharpSlang.Dxc.targets" />

</Project>
