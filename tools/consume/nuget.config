<?xml version="1.0" encoding="utf-8"?>
<!--
  The smoke consumer's sources: the folder feed with the packed .nupkg files, and nuget.org for
  what they depend on (Microsoft.Direct3D.DXC, SharpNRI.Descs). `local` is the repository's nupkg/;
  consume.ps1 passes the feed it was given as RestoreSources instead, and restores into this
  project's own packages folder (obj/packages, emptied first), so a package of the same version in
  the global cache, or on a machine-wide feed, cannot stand in for the one just packed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../nupkg" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
